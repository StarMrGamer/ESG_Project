# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local secrets / env
.env
*.env

# RAG retrieval cache (live-fetch results, regenerated on demand)
.cache/

# Runtime monitoring state (pinned tickers) — local, rebuilt per user, not source
data/watchlist.json

# React frontend build artifacts / dependencies
web/node_modules/
web/dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Team hand-off pack (D/) — the briefs, the pitch deck and the Prototype_Pack zip.
# Local-only: it is the team's source material, not this repo's source. Code that was built
# FROM it cites it by path (data/backtest_cases.json -> D/Backtest_Candidates_for_Rai.md);
# those citations name where the evidence came from, and stay accurate off-repo.
D/

# Harvested evidence is COMMITTED (it is dated, sourced, and part of what a run scored) —
# but the in-progress scratch of a partial sweep is not. Nothing to ignore here yet; this
# note exists so nobody adds data/harvest/ to this file by reflex.

# The per-sweep run log is scratch — `data/news/` IS the record, and the log's counts are
# whatever the module printed at the time (a pre-refilter sweep left impossible ones behind).
data/news_sweep.log

# Demo-reel intermediates — regenerated by scripts/record_demo_reel.mjs (the MP4s beside
# them are the deliverable and are kept).
docs/pitch/video/reel/assets/
docs/pitch/video/reel/raw/
docs/pitch/video/reel/renders/
docs/pitch/video/reel/snapshots/
docs/pitch/video/reel/node_modules/

# Analyst reel intermediates — the raw take and the per-chapter cuts are rebuildable from
# `record_demo_reel.mjs --analyst` against a running app. The assembled 3:00 mp4 and the
# narration script beside them are the deliverables and are deliberately NOT ignored.
docs/pitch/video/analyst/assets/
docs/pitch/video/analyst/raw/

# Competition reel intermediates — the raw take and the per-scene narration are rebuildable
# (`record_competition_reel.mjs`, `heygen-tts`). The finished mp4 in competition/ is the
# deliverable and IS kept.
docs/pitch/video/reel/raw-competition/
docs/pitch/video/tts-competition/*.wav
