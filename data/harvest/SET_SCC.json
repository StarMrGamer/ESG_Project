 "events": [
  {
   "event_id": "SET:SCC-harvest-0",
   "text": "The Siam Cement Public Company Limited's Phase 1 (2020-2030) goal is to reduce Scope 1 and 2 greenhouse gas emissions as The Science Based Targets initiative (SBTi) goal by 25% by 2030 compared to the 2020 base year, and shift from fossil fuel energy sources to renewable and clean energy.",
   "published_at": "2025-03-13",
   "source_url": "https://file.scgsustainability.com/wp-content/uploads/2025/03/13155954/EN-SCG-SD-Report_2024..pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:SCC-harvest-1",
   "text": "SCC issued an update on the Map Ta Phut Tank Terminal incident in Rayong Province, referencing prior notifications to the Stock Exchange of Thailand on May 9, 10 and 15, 2024 regarding a fire at the storage tank containing the by-product hydrocarbon compound C9+.",
   "published_at": "2024-05-27",
   "source_url": "https://scc.listedcompany.com/newsroom/270520242111260214E.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:SCC-harvest-2",
   "text": "The Board of Directors approved the INSEE Sustainability Ambition 2030 pillars and targets in 2023 and assigned the Group CEO to establish the Sustainability Steering Committee (SSC).",
   "published_at": "2023-01-01",
   "source_url": "https://www.siamcitycement.com/front/template/default/assets_country/download/thailand/esg_publication/ESG-2024.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:SCC-harvest-3",
   "text": "Siam Cement (SCG) increased the sales share of Low Carbon Cement in 2024.",
   "published_at": "2024-01-01",
   "source_url": "https://www.sustainabilityreports.com/siam-cement/2024/one-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:SCC-harvest-4",
   "text": "On May 9, 2024, at approximately 10:45 a.m., there was smoke at the tank where the hydrocarbon compound C9+ is stored at Map Ta Phut Tank Terminal Company Limited (MTT), a subsidiary of SCC, located at the Map Ta Phut Industrial Port in Rayong Province; MTT immediately controlled the situation.",
   "published_at": "2024-05-09",
   "source_url": "https://www.kaohooninternational.com/markets/539522",
   "source_type": "company_pr",
   "_origin": "harvest"
  }
 ],
