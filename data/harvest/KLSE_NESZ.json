{
 "company_id": "KLSE:NESZ",
 "company": "Nestle (Malaysia)",
 "events": [
  {
   "event_id": "KLSE:NESZ-harvest-0",
   "text": "Nestle Malaysia has committed to planting another three million trees by 2030 to support biodiversity conservation and climate resilience.",
   "published_at": "2026-08-01",
   "source_url": "https://www.nst.com.my/business/corporate/2026/08/1503606/nestle-malaysia-outpaces-2025-emissions-target",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-1",
   "text": "Nestle Malaysia exceeded its 2025 emissions target and is now focused on achieving a 50 per cent reduction in greenhouse gas emissions by 2030 as part of its pathway towards net zero by 2050.",
   "published_at": "2026-08-01",
   "source_url": "https://www.nst.com.my/business/corporate/2026/08/1503249/nestle-malaysia-beats-2025-emissions-goal-ahead-schedule",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-2",
   "text": "Nestlé Malaysia announced on December 8, 2021 that it will fully transition to 100% renewable electricity across all its operations in Malaysia as of 1 January 2022, reducing emissions by 75,000 tonnes of CO2 equivalent every year.",
   "published_at": "2021-12-08",
   "source_url": "https://www.nestle.com.my/media/pressreleases/renewable-energy",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-3",
   "text": "In January 2022, Nestlé Malaysia successfully transitioned to utilising 100% renewable electricity for all Nestlé facilities in both East and West Malaysia, subscribing to the Green Electricity Tariff (GET) Programme by Tenaga Nasional Berhad and the Renewable Energy Certificate (REC) by Sarawak Energy.",
   "published_at": "2022-01-01",
   "source_url": "https://www.nestle.com.my/sustainability/climate-change",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-4",
   "text": "Nestle Manufacturing (Malaysia) Sdn Bhd was fined RM90,000 by the Shah Alam Sessions Court on Dec 24, 2020 on two counts of releasing industrial effluent in excess of the acceptable limit.",
   "published_at": "2020-12-24",
   "source_url": "https://www.themalaysianinsight.com/s/291579",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-5",
   "text": "Nestlé Malaysia's 2025 progress includes a 31% GHG reduction against the 2018 baseline.",
   "published_at": "2025-01-01",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2025/creating-shared-value-and-sustainability-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-6",
   "text": "Nestlé Malaysia's 2025 progress includes 95.6% of packaging designed for recycling.",
   "published_at": "2025-01-01",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2025/creating-shared-value-and-sustainability-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-7",
   "text": "Nestle (Malaysia) Bhd's 2023 Sustainability Report reports achieving a 25% reduction in GHG emissions from a 2018 baseline.",
   "published_at": "2023-01-01",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2023/society-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-8",
   "text": "Nestle Manufacturing (Malaysia) Sdn Bhd was fined RM90,000 by the Sessions Court in Shah Alam on two counts of releasing industrial effluent in excess of the acceptable limit.",
   "published_at": "2020-12-24",
   "source_url": "https://www.malaysianow.com/news/2020/12/24/nestle-fined-rm90000-for-environmental-pollution",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-9",
   "text": "Nestlé Malaysia has reduced its greenhouse gas (GHG) emissions by 31% from its 2018 baseline, surpassing its interim target of a 20% reduction by 2025.",
   "published_at": "2026-08-03",
   "source_url": "https://www.thestar.com.my/business/business-news/2026/08/03/nestl-malaysia-cuts-emissions-31-eyes-50-cut-by-2030",
   "source_type": "news",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-10",
   "text": "Nestlé Malaysia achieved a 25% reduction in GHG emissions from a 2018 baseline in 2023.",
   "published_at": "2023-12-31",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2023/society-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-11",
   "text": "Nestlé Malaysia transitioned to 100% renewable electricity in 2023.",
   "published_at": "2023-12-31",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2023/society-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-12",
   "text": "Nestlé Malaysia planted 1.5 million trees through Project RELeaf since 2021.",
   "published_at": "2023-12-31",
   "source_url": "https://www.sustainabilityreports.com/nestle-malaysia/2023/society-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-13",
   "text": "The Board of Directors approved the 2023 Nestlé Creating Shared Value and Sustainability Report to be issued on February 22, 2024, subject to approval at the Annual General Meeting on April 18, 2024.",
   "published_at": "2024-02-22",
   "source_url": "https://www.nestle.com/sites/default/files/2024-02/creating-shared-value-sustainability-report-2023-en.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-14",
   "text": "Nestle (Malaysia) Bhd has planned RM1 billion in capital expenditure (capex) for a new cycle of investment for the 2023-2025 period.",
   "published_at": "2023-02-22",
   "source_url": "https://www.pressreader.com/malaysia/the-sun-malaysia/20230222/281719798768597",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:NESZ-harvest-15",
   "text": "Nestlé reported on the EU Code of Conduct on responsible food business and marketing practices in 2024.",
   "published_at": "2024-01-01",
   "source_url": "https://transition-pathways.europa.eu/agri-food/reports/nestle-report-code-conduct-2024",
