   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-4",
   "text": "DBS Group Holdings Ltd broadcast a Sustainability Report announcement to SGX on 06-Mar-2025 at 07:38:13.",
   "published_at": "2025-03-06",
   "source_url": "https://links.sgx.com/1.0.0/corporate-announcements/OV9G8KM2AL25E055/22d90def292df286e2c267ffe1e7cd87f727c334d696fcffa0607b9e0e3d2b5a",
   "source_type": "exchange_filing",
   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-5",
   "text": "On 12 Sept 2022, DBS announced sectoral decarbonisation targets covering nine industry sectors, aligned with science-based decarbonisation glidepaths, as part of its commitment to being net zero in its financed emissions by 2050.",
   "published_at": "2022-09-12",
   "source_url": "https://www.dbs.com/newsroom/Singapores_DBS_first_bank_in_Southeast_Asia_to_announce_landmark_set_of_decarbonisation_commitments",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-6",
   "text": "DBS's 2024 Sustainability Report reaffirms a well-structured ESG governance system with clear Board oversight and a Board-level Sustainability Committee holding direct responsibility for climate and sustainability risks.",
   "published_at": "2025-12-01",
   "source_url": "https://sustainabilityareyousure.blogspot.com/2025/12/dbs-sustainability-report-2024-review.html",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-7",
   "text": "The Board Risk Management Committee Technology Risk Committee (BTRC), established to strengthen technology risk governance and oversight, was dissolved in January 2025.",
