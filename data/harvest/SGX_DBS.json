   "source_url": "https://www.marketscreener.com/quote/stock/DBS-GROUP-HOLDINGS-LTD-6491408/news/DBS-2024-Annual-Report-49250357/",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-8",
   "text": "DBS Group filed its Sustainability Report 2024 via SGX announcement on 6 March 2025.",
   "published_at": "2025-03-06",
   "source_url": "https://links.sgx.com/1.0.0/corporate-announcements/OV9G8KM2AL25E055/22d90def292df286e2c267ffe1e7cd87f727c334d696fcffa0607b9e0e3d2b5a",
   "source_type": "exchange_filing",
   "_origin": "harvest"
  },
  {
   "event_id": "SGX:DBS-harvest-9",
   "text": "DBS Group grew its sustainable financing commitments, net of repayments, by 37.3% to S$70 billion ($52.10 billion) as of end-December 2023, from S$51 billion in 2022.",
