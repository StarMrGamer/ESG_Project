   "source_url": "https://www.reuters.com/sustainability/sustainable-finance-reporting/singaporean-bank-dbs-grows-sustainable-financing-by-37-521-bln-2023-2024-03-06/",
   "source_type": "news",
   "_origin": "harvest"
  },
  {
