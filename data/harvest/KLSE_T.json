 "events": [
  {
   "event_id": "KLSE:T-harvest-0",
   "text": "The board together with management takes responsibility for the governance of sustainability in the company including setting the company's sustainability strategies, priorities and targets.",
   "published_at": "2026-04-01",
   "source_url": "https://tm.com.my/sites/default/files/2026-04/CG%20Report%202025_TM.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-1",
   "text": "Telekom Malaysia said it will continue to extend its full cooperation with the US Department of Justice (DOJ) concerning former employees of TM USA Inc., after it had earlier initiated its own investigation pursuant to suspicion of misconduct by the individuals, which led to their dismissal.",
   "published_at": "2026-05-20",
   "source_url": "https://www.malaymail.com/news/malaysia/2026/05/20/telekom-malaysia-says-cooperating-with-us-doj-over-alleged-misconduct-by-former-tm-usa-employees/220667",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-2",
   "text": "In 2025, Telekom Malaysia embedded sustainability metrics and targets into the KPIs and remuneration of key leadership positions for the second year.",
   "published_at": "2025-01-01",
   "source_url": "https://tm.com.my/sites/default/files/2026-05/%5BPages%20100-251%5D%20Telekom%20Malaysia%20Berhad%20IAR25.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-3",
   "text": "Telekom Malaysia said it will continue to extend full cooperation with the US Department of Justice concerning former employees of TM USA Inc., after initiating its own investigation pursuant to suspicion of misconduct that led to their dismissal.",
   "published_at": "2026-05-20",
   "source_url": "https://www.malaymail.com/news/malaysia/2026/05/20/telekom-malaysia-says-cooperating-with-us-doj-over-alleged-misconduct-by-former-tm-usa-employees/220667",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-4",
   "text": "In 2024, Telekom Malaysia reduced its carbon emissions by 30% compared to the 2019 baseline.",
   "published_at": "2024-12-31",
   "source_url": "https://www.sustainabilityreports.com/telekom-malaysia/2024/integrated-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-5",
   "text": "TM achieved a 34% carbon emission reduction against its 2019 baseline, marking steady progress towards achieving 62% by 2030 and net zero emissions by 2050.",
   "published_at": "2026-05-01",
   "source_url": "https://tm.com.my/sites/default/files/2026-05/%5BPages%20100-251%5D%20Telekom%20Malaysia%20Berhad%20IAR25.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-6",
   "text": "In 2023, TM refreshed its Group level Sustainability Governance Structure to strengthen oversight and execution of sustainability and climate change initiatives and define reporting lines.",
   "published_at": "2023-01-01",
   "source_url": "https://www1.tm.com.my/sites/default/files/2024-05/2023%20TCFD%20Report_29.4.2024_3.52PM.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:T-harvest-7",
   "text": "Telekom Malaysia achieved a 22% reduction in carbon emissions in 2023, compared with its 2019 baseline, through energy-efficiency initiatives and by increasing its renewable energy mix.",
   "published_at": "2023-01-01",
   "source_url": "https://theedgemalaysia.com/node/731506",
   "source_type": "news",
   "_origin": "harvest"
  }
