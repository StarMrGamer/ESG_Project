  {
   "event_id": "PSE:BDO-harvest-0",
   "text": "On February 18, 2025, the Board Audit Committee (BAC) endorsed for Board approval the 2024 Audited Financial Statements.",
   "published_at": "2025-02-18",
   "source_url": "https://esgimpactawards.inquirer.net/wp-content/uploads/2026/05/bdo-unibank-2025-annual-report-financial-supplements.pdf",
   "source_type": "news",
   "_origin": "harvest"
  },
  {
   "event_id": "PSE:BDO-harvest-1",
   "text": "BDO's Sustainable Finance Framework (Second Party, May 2022) allows it to issue green, blue, social and sustainability bonds and loans for eligible categories including Renewable Energy, Green Buildings, and Clean Transportation.",
   "published_at": "2022-05-01",
   "source_url": "https://www.bdo.com.ph/content/dam/bdounibank/en-ph/about-bdo/sustainability/pdf/sustainable-finance/BDO-Sustainable-Finance-Framework-Second-Party-May2022.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "PSE:BDO-harvest-2",
   "text": "BDO has expanded its sustainable finance framework to support a wider range of projects with high economic, environmental and social benefits through its bond issuances.",
   "published_at": "2024-09-04",
   "source_url": "https://www.philstar.com/business/2024/09/04/2382636/bdo-expands-sustainable-finance-framework",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "PSE:BDO-harvest-3",
   "text": "As of July 2025, BDO has channeled over PHP 1 trillion into sustainable projects.",
   "published_at": "2025-07-01",
   "source_url": "https://powerphilippines.com/bdo-raises-php-115b-via-sustainability-bonds-eyes-more-green-energy-deals/",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "PSE:BDO-harvest-4",
   "text": "BDO expanded its Sustainable Finance Framework and received an updated Second Party Opinion from Morningstar Sustainalytics affirming the credibility and impact of the framework.",
   "published_at": "2024-09-01",
   "source_url": "https://www.cagayantoday.info/2024/09/bdo-expands-sustainable-finance.html",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "PSE:BDO-harvest-5",
   "text": "On October 2, 2024, the Supreme Court issued G.R. No. 255367, in which BDO's Petition for Review assailed the Court of Appeals resolutions (CA-G.R. CR No. 39969) that denied BDO's motion to intervene in Criminal Case No. 09-2643 (People of the Philippines v. Ruby O. Alda, Elizabeth O. Alda, and Michael S. Bungque).",
   "published_at": "2024-10-02",
   "source_url": "https://lawphil.net/judjuris/juri2024/oct2024/gr_255367_2024.html",
   "source_type": "company_pr",
   "_origin": "harvest"
  }
