 "events": [
  {
   "event_id": "KLSE:MAY-harvest-0",
   "text": "In 2023, Malayan Banking Berhad's 53.0% reduction in Scope 1 and 2 emissions against a 2019 baseline was verified by third-party assurance.",
   "published_at": "2023-01-01",
   "source_url": "https://sustify.world/profile/1155_2024_MY",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-1",
   "text": "Maybank Islamic Bhd, a unit of Malayan Banking Bhd, was fined RM1.2 million by Bank Negara Malaysia for non-compliance with financial services laws.",
   "published_at": "2025-05-28",
   "source_url": "https://klse.i3investor.com/web/blog/detail/ceomorningbrief/2025-05-29-story-h499513667-Bank_Negara_Fines_Four_Lenders_for_Non_compliance_With_Financial_Service",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-2",
   "text": "Bank Negara Malaysia imposed an Administrative Monetary Penalty of RM4,320,000 on Malayan Banking Berhad and Maybank Islamic Berhad for non-compliance with paragraph 48(1)(a) of the Financial Services Act 2013 and paragraph 58(1)(a) of the Islamic Financial Services Act.",
   "published_at": "2024-07-29",
   "source_url": "https://www.bnm.gov.my/-/ea-mybnk24",
   "source_type": "regulator",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-3",
   "text": "Maybank became the first Malaysian bank to establish a sustainable product framework aimed to guide the development of green, social, sustainable, sustainability-linked and transition products effective Sept 1, 2022.",
   "published_at": "2022-09-01",
   "source_url": "https://www.abm.org.my/esg-product-service/maybank-mobilises-rm34-37b-in-sustainable-finance/",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-4",
   "text": "Bank Negara Malaysia fined Maybank Islamic Bhd RM1.2 million as part of nearly RM5 million in penalties on four lenders for non-compliance with financial services laws.",
   "published_at": "2025-05-28",
   "source_url": "https://klse.i3investor.com/web/blog/detail/ceomorningbrief/2025-05-29-story-h499513667-Bank_Negara_Fines_Four_Lenders_for_Non_compliance_With_Financial_Service",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-5",
   "text": "The Group's Scope 1, 2 and selected Scope 3 greenhouse gas (GHG) emissions for the period of 1 January 2024 to 31 December 2024 had been subjected to an independent limited assurance by PricewaterhouseCoopers PLT, Malaysia (PwC).",
   "published_at": "2025-03-26",
   "source_url": "https://maybank.listedcompany.com/newsroom/Maybank_Environmental_Report_2024_20250326.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-6",
   "text": "Maybank Investment Bank Berhad acted as Sustainability Framework Adviser for Tenaga Nasional's framework, which obtained a Second-Party Opinion by Morningstar Sustainalytics.",
   "published_at": "2024-09-24",
   "source_url": "https://www.tnb.com.my/assets/press_releases/2024092420_ENG.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:MAY-harvest-7",
   "text": "Maybank's sustainable finance disclosures, including retail and non-retail sustainable finance mobilised for the period from 1 January 2024 to 31 December 2024, have been subjected to an independent limited assurance by PricewaterhouseCoopers PLT, Malaysia (PwC).",
   "published_at": "2025-03-26",
   "source_url": "https://maybank.listedcompany.com/newsroom/Maybank_Sustainability_Report_2024_20250326.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  }
