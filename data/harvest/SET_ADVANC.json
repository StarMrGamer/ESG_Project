   "source_url": "https://www.sustainabilityreports.com/advanced-info-service/2023/annual-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:ADVANC-harvest-6",
   "text": "AIS issued Thailand's first telecommunications sustainability bond of THB 25 billion in 2024.",
   "published_at": "2024-01-01",
   "source_url": "https://www.sustainabilityreports.com/advanced-info-service/2024/one-report",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
