  },
  {
   "event_id": "SET:ADVANC-harvest-2",
   "text": "AIS designed its Sustainable Finance Framework under which the AIS Group and its subsidiaries can issue Green, Social and Sustainability Bonds, Loans and other financial instruments to finance or refinance projects.",
   "published_at": "2024-09-01",
   "source_url": "https://investor.ais.co.th/storage/document/sustainable-finance/2024/advanc-sustainable-finance-framework-sep-2024-en.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:ADVANC-harvest-3",
   "text": "Advanced Wireless Network Company Limited, part of the AIS group, funded a THB 2,000 million green loan to support sustainable development through solar energy projects aligned with the AIS Sustainable Finance Framework.",
   "published_at": "2024-01-01",
   "source_url": "https://investor.ais.co.th/storage/document/sustainable-finance/2024/advanc-sustainable-financing-report-en.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:ADVANC-harvest-4",
   "text": "AIS received recognition through the Best Sustainability Bond and Best Green Loan - Telecom awards at The Asset Triple A Sustainable Finance Awards 2025.",
   "published_at": "2025-01-01",
   "source_url": "https://www.marketscreener.com/news/advanced-info-service-ais-sustainability-report-2025-ce7e5cd3de8bf32d",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "SET:ADVANC-harvest-5",
   "text": "In 2023, Advanced Info Service reduced its greenhouse gas emissions intensity by 92% compared to the 2015 baseline and increased renewable energy usage to 2.25% of total energy consumption.",
