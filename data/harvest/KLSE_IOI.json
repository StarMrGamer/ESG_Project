   "event_id": "KLSE:IOI-harvest-0",
   "text": "IOI first embarked on reducing its greenhouse gas emissions in 2019 through the introduction of the Climate Change Action initiative ('CCAi').",
   "published_at": "2019-01-01",
   "source_url": "https://www.ioigroup.com/Files/sustainability/pdf/IOI'S%20PATHWAY%20TO%20NET%20ZERO.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:IOI-harvest-1",
   "text": "In 2021, IOI proceeded to adopt recommendations from the Task Force on Climate-Related Financial Disclosures ('TCFD') around four thematic areas.",
   "published_at": "2021-01-01",
   "source_url": "https://www.ioigroup.com/Files/sustainability/pdf/IOI'S%20PATHWAY%20TO%20NET%20ZERO.pdf",
   "source_type": "company_pr",
   "_origin": "harvest"
  },
  {
   "event_id": "KLSE:IOI-harvest-2",
   "text": "UOB Malaysia announced on 25 July 2022 that it extended a green trade finance facility under the UOB Green and Sustainable Trade Finance Framework to IOI Corporation Berhad to promote sustainable palm oil and strengthen the global sustainable palm oil supply chain.",
   "published_at": "2022-07-25",
   "source_url": "https://www.uob.com.my/about/news/2022/news-release-jul25-22.page",
   "source_type": "company_pr",
   "_origin": "harvest"
  }
