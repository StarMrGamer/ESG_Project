# Copy to /etc/esg-radar.env and chmod 600 — this file may hold secrets.
# Every value is optional; the app degrades honestly when one is missing.

# --- binding -----------------------------------------------------------------
# Behind a reverse proxy, bind to loopback ONLY. If you leave this at 0.0.0.0 the app port
# stays directly reachable and anyone can bypass the proxy's authentication.
HOST=127.0.0.1
PORT=8000

# --- LLM ---------------------------------------------------------------------
# Powers the Stage 1 -> 2 -> 3 deep-dive relay ONLY. The dashboard, the scoring engine, the
# quadrant matrix, the tier flips, the evidence trail and on-chain verification all work
# without it, and /api/health reports `llm_configured: false` honestly.
#
# ON A PUBLICLY REACHABLE INSTANCE, LEAVE THIS UNSET unless the proxy enforces auth: the
# relay endpoints have no authentication and every call is billed to this key.
# DEEPSEEK_API_KEY=sk-...

# --- uploads -----------------------------------------------------------------
# Uploads are read into memory; this caps them. A Contract-B JSON/CSV is kilobytes.
ESG_MAX_UPLOAD_MB=5

# --- live retrieval (all optional, sensible defaults in core.py) --------------
# ESG_HTTP_TIMEOUT=10
# ESG_RAG_TOP_K=5
# ESG_RAG_MAX_DOCS=12
# ESG_RAG_TTL=21600
# ESG_LLM_TIMEOUT=30
# ESG_USER_AGENT="ESG-Radar/2.0 (+https://example.org)"

# --- evidence anchoring (Build Spec C3) --------------------------------------
# Without these, runs are recorded `anchor_pending` and the UI says so — verification still
# works locally against the stored run record. ESG_ANCHOR_KEY is a WALLET PRIVATE KEY: use a
# throwaway hackathon wallet holding only testnet ETH, never a real one.
# ESG_ANCHOR_RPC=https://sepolia.infura.io/v3/...
# ESG_ANCHOR_CONTRACT=0x...
# ESG_ANCHOR_KEY=0x...
# ESG_ANCHOR_EXPLORER=https://sepolia.etherscan.io
